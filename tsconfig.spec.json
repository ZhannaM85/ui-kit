{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jest",
      "node"
    ],
    "esModuleInterop": true,
    "paths": {
      "@angular/core/testing": ["./node_modules/@angular/core/types/testing.d.ts"],
      "@angular/core": ["./node_modules/@angular/core/types/core.d.ts"]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "setup-jest.ts"
  ]
}
